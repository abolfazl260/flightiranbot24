[Unit]
Description=Flight Iran Bot 24 - Bale messenger
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/flightiranbot24
EnvironmentFile=/etc/flightiranbot24/flightiran.env
Environment=BALE_DATABASE_URL=sqlite+aiosqlite:////opt/flightiranbot24/flightiran-bale.db
ExecStart=/opt/flightiranbot24/.venv/bin/flightiran-bale
Restart=on-failure
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
