<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.FlightIran" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorAccent">@color/teal</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:statusBarColor">@color/navy</item>
        <item name="android:navigationBarColor">@color/navy</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@color/pale</item>
    </style>
    <style name="AdvertioHeadline">
        <item name="android:textColor">@color/navy</item>
        <item name="android:textSize">24sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="AdvertioBody">
        <item name="android:textColor">@color/slate</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>
    <style name="ServiceButton" parent="@android:style/Widget.Material.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:background">@drawable/service_button_background</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
    </style>
    <!-- Roomier, touch-friendly checklist grouped into quiet mint section bands. -->
    <style name="ChecklistSectionBand">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">76dp</item>
        <item name="android:layout_marginTop">32dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">16dp</item>
        <item name="android:background">@drawable/checklist_section_background</item>
    </style>
    <style name="ChecklistSectionHeading">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/navy</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">18sp</item>
    </style>
    <style name="ChecklistSectionHint">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:textColor">@color/slate</item>
        <item name="android:textSize">13sp</item>
    </style>
    <style name="ChecklistResetButton" parent="@android:style/Widget.Material.Button.Borderless">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:layout_marginTop">34dp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:background">@drawable/checklist_reset_background</item>
        <item name="android:textSize">15sp</item>
    </style>
    <style name="ChecklistItem" parent="@android:style/Widget.CompoundButton.CheckBox">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">76dp</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">18dp</item>
        <item name="android:paddingBottom">18dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:background">@drawable/checklist_task_background</item>
        <item name="android:buttonTint">@color/teal</item>
        <item name="android:drawablePadding">12dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/navy</item>
    </style>
</resources>
