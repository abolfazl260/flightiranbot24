<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:layoutDirection="rtl"
    android:background="@color/pale">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_gravity="center_horizontal"
            android:src="@drawable/ic_launcher"
            android:contentDescription="@string/app_name" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:text="@string/welcome_title"
            android:textColor="@color/navy"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="@string/welcome_description"
            android:textColor="@color/slate"
            android:textSize="16sp" />

        <Button
            android:id="@+id/openBot"
            style="@style/ServiceButton"
            android:layout_marginTop="24dp"
            android:text="@string/open_bot" />

        <Button android:id="@+id/offlineAirports" style="@style/ServiceButton"
            android:text="@string/offline_airports" />
        <Button android:id="@+id/checklist" style="@style/ServiceButton"
            android:text="@string/checklist_title" />
        <Button android:id="@+id/openVisa" style="@style/ServiceButton"
            android:text="@string/open_visa" />
        <Button android:id="@+id/openAirports" style="@style/ServiceButton"
            android:text="@string/open_airports" />
        <Button android:id="@+id/openUseful" style="@style/ServiceButton"
            android:text="@string/open_useful" />
        <Button android:id="@+id/openSupport" style="@style/ServiceButton"
            android:text="@string/open_support" />
        <Button android:id="@+id/openPrivacy" style="@style/ServiceButton"
            android:text="@string/open_privacy" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="@string/command_hint"
            android:textColor="@color/slate"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="@string/notice"
            android:textColor="@color/slate"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
