# Required to start the Telegram polling process.
TELEGRAM_BOT_TOKEN=

# Telegram user/chat ID that receives runtime error reports.
TELEGRAM_ADMIN_ID=106056586

# Safe local defaults for development.
DATABASE_URL=sqlite+aiosqlite:///./flightiran.db
LOG_LEVEL=INFO
# Optional provider endpoints; credentials must be supplied through environment settings.
CURRENCY_PROVIDER_URL=
CURRENCY_PROXY_URL=
TICKET_PROVIDER_URL=https://mz724.ir/
# Support contact used across ticket listings, /help and the main menu.
SUPPORT_USERNAME=@advertio_support
# Legacy TICKET_SUPPORT_USERNAME is also accepted for older deployments.
# mz724 price history: capture hourly and keep only the rolling 21-day window.
TICKET_HISTORY_INTERVAL_MINUTES=60
TICKET_HISTORY_RETENTION_DAYS=21
# User-controlled price bell, checked with each scheduled mz724 capture.
PRICE_ALERTS_ENABLED=true
APP_ENV=development
WEB_APP_ENABLED=false
WEB_APP_URL=https://bot.example.com

# TravelRequirements.info direct HTTPS data sync (no GitHub/API key).
VISA_SYNC_ENABLED=true
VISA_SYNC_INTERVAL_HOURS=6

# Daily private report of unique users active in the past 24 hours.
# Uses both Telegram bot interactions and authenticated Web App sessions.
ACTIVE_USERS_REPORT_ENABLED=true
ACTIVE_USERS_REPORT_TIME=09:00
ACTIVE_USERS_REPORT_TIMEZONE=Asia/Tehran
