# Required to start the Telegram polling process.
TELEGRAM_BOT_TOKEN=

# Safe local defaults for development.
DATABASE_URL=sqlite+aiosqlite:///./flightiran.db
LOG_LEVEL=INFO
FLIGHT_TRACKING_ENABLED=true
# FlightRadar24 search/detail endpoints. Override only when using a proxy/provider adapter.
FLIGHT_PROVIDER_URL=https://www.flightradar24.com/v1/search/web/find
FLIGHT_PROVIDER_DETAILS_URL=https://data-live.flightradar24.com/clickhandler/
# Optional provider endpoints; credentials must be supplied through environment settings.
CURRENCY_PROVIDER_URL=
CURRENCY_PROXY_URL=
TICKET_PROVIDER_URL=https://mz724.ir/
TICKET_SUPPORT_USERNAME=@vlansupport
APP_ENV=development
WEB_APP_ENABLED=false
WEB_APP_URL=https://bot.example.com
