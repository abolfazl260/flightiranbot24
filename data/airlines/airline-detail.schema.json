{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "airline_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,79}$"
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "sections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/section"
      },
      "maxItems": 100
    },
    "published_reviews": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/publishedReview"
      },
      "maxItems": 1000
    },
    "experience_links": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/experienceLink"
      },
      "maxItems": 1000
    }
  },
  "required": [
    "schema_version",
    "airline_id",
    "metadata",
    "sections",
    "published_reviews",
    "experience_links"
  ],
  "$defs": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "draft",
            "published",
            "archived"
          ]
        },
        "source_urls": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://",
            "maxLength": 2048
          },
          "maxItems": 20
        },
        "verified_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "effective_from": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "effective_to": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "stale": {
          "type": "boolean"
        },
        "confidence": {
          "enum": [
            "official",
            "secondary",
            "unverified"
          ]
        }
      },
      "required": [
        "status",
        "source_urls",
        "verified_at",
        "effective_from",
        "effective_to",
        "stale",
        "confidence"
      ]
    },
    "code": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "system": {
          "enum": [
            "iata",
            "icao"
          ]
        },
        "value": {
          "type": "string",
          "pattern": "^[A-Z0-9]{2,3}$"
        },
        "valid_from": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "valid_to": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "shared": {
          "type": "boolean"
        }
      },
      "required": [
        "system",
        "value",
        "valid_from",
        "valid_to",
        "shared"
      ]
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name_fa": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "name_en": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "legal_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "country": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "country_fa": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "maxItems": 30
        },
        "former_names": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "maxItems": 30
        },
        "codes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/code"
          },
          "maxItems": 30
        },
        "website": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://",
          "maxLength": 2048
        }
      },
      "required": [
        "name_fa",
        "name_en",
        "legal_name",
        "country",
        "country_fa",
        "aliases",
        "former_names",
        "codes",
        "website"
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "route": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 200
        },
        "fare_brand": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 200
        },
        "cabin_class": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 200
        },
        "operating_carrier": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 200
        },
        "seller": {
          "enum": [
            "airline",
            "agency",
            "third_party",
            "unknown"
          ]
        },
        "journey_type": {
          "enum": [
            "domestic",
            "international",
            "unknown"
          ]
        },
        "note_fa": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        }
      },
      "required": [
        "route",
        "fare_brand",
        "cabin_class",
        "operating_carrier",
        "seller",
        "journey_type",
        "note_fa"
      ]
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "image",
            "video"
          ]
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://",
          "maxLength": 2048
        },
        "title_fa": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "license": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "attribution_fa": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "rights_verified": {
          "const": true
        },
        "source_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://",
          "maxLength": 2048
        }
      },
      "required": [
        "type",
        "url",
        "title_fa",
        "license",
        "attribution_fa",
        "rights_verified",
        "source_url"
      ]
    },
    "fleet": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "fleet_snapshot"
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "manufacturer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "status": {
          "enum": [
            "active",
            "stored",
            "leased-in",
            "leased-out",
            "retired",
            "unknown"
          ]
        },
        "relationship": {
          "enum": [
            "owned",
            "operated",
            "leased",
            "unknown"
          ]
        },
        "configuration_fa": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 200
        },
        "metadata": {
          "$ref": "#/$defs/metadata"
        }
      },
      "required": [
        "type",
        "model",
        "manufacturer",
        "count",
        "observed_at",
        "status",
        "relationship",
        "configuration_fa",
        "metadata"
      ]
    },
    "block": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "text"
            },
            "text_fa": {
              "type": "string",
              "minLength": 1,
              "maxLength": 10000
            }
          },
          "required": [
            "type",
            "text_fa"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "bullets"
            },
            "items_fa": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 10000
              },
              "maxItems": 50,
              "minItems": 1
            }
          },
          "required": [
            "type",
            "items_fa"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "link"
            },
            "title_fa": {
              "type": "string",
              "minLength": 1,
              "maxLength": 10000
            },
            "url": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://",
              "maxLength": 2048
            }
          },
          "required": [
            "type",
            "title_fa",
            "url"
          ]
        },
        {
          "$ref": "#/$defs/media"
        },
        {
          "$ref": "#/$defs/fleet"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "airport_link"
            },
            "iata": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            },
            "title_fa": {
              "type": "string",
              "minLength": 1,
              "maxLength": 10000
            }
          },
          "required": [
            "type",
            "iata",
            "title_fa"
          ]
        },
        {
          "$ref": "#/$defs/route"
        }
      ]
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,79}$"
        },
        "title_fa": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "icon": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "order": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "kind": {
          "enum": [
            "information",
            "policy",
            "fleet",
            "network"
          ]
        },
        "metadata": {
          "$ref": "#/$defs/metadata"
        },
        "scope": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/scope"
            }
          ]
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/block"
          },
          "maxItems": 200
        }
      },
      "required": [
        "id",
        "title_fa",
        "icon",
        "order",
        "kind",
        "metadata",
        "scope",
        "blocks"
      ]
    },
    "publishedReview": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "review_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,79}$"
        },
        "airline_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,79}$"
        },
        "experience_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 200
        },
        "visit_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "publication_timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "consent_status": {
          "const": "granted"
        },
        "moderation_status": {
          "const": "approved"
        },
        "verified_origin": {
          "const": true
        },
        "privacy_reviewed": {
          "const": true
        },
        "conflict_of_interest": {
          "const": false
        },
        "ratings": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "overall": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "crew": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "seat": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "cleanliness": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "catering": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "checkin": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "baggage": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "value": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            }
          },
          "required": [],
          "minProperties": 1
        }
      },
      "required": [
        "review_id",
        "airline_id",
        "experience_id",
        "visit_date",
        "publication_timestamp",
        "consent_status",
        "moderation_status",
        "verified_origin",
        "privacy_reviewed",
        "conflict_of_interest",
        "ratings"
      ]
    },
    "experienceLink": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "experience_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,79}$"
        },
        "airline_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,79}$"
          },
          "maxItems": 10,
          "minItems": 1,
          "uniqueItems": true
        },
        "relationship": {
          "enum": [
            "operating",
            "marketing",
            "mentioned",
            "unknown"
          ]
        },
        "source_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://",
          "maxLength": 2048
        },
        "consent_status": {
          "enum": [
            "unknown",
            "granted",
            "denied"
          ]
        },
        "moderation_status": {
          "enum": [
            "pending",
            "approved",
            "rejected"
          ]
        },
        "privacy_reviewed": {
          "type": "boolean"
        }
      },
      "required": [
        "experience_id",
        "airline_ids",
        "relationship",
        "source_url",
        "consent_status",
        "moderation_status",
        "privacy_reviewed"
      ]
    },
    "reviewSubmission": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "submission_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,79}$"
        },
        "moderation_status": {
          "enum": [
            "pending",
            "rejected"
          ]
        },
        "ratings": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "overall": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "crew": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "seat": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "cleanliness": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "catering": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "checkin": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "baggage": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "value": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            }
          },
          "required": [],
          "minProperties": 1
        }
      },
      "required": [
        "submission_id",
        "moderation_status",
        "ratings"
      ]
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "route_snapshot"
        },
        "origin": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "destination": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "service_type": {
          "enum": [
            "non_stop",
            "connecting",
            "unknown"
          ]
        },
        "operating_carrier": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z][a-z0-9-]{1,79}$"
        },
        "status": {
          "enum": [
            "listed",
            "announced",
            "seasonal",
            "suspended",
            "unknown"
          ]
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "note_fa": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "metadata": {
          "$ref": "#/$defs/metadata"
        }
      },
      "required": [
        "type",
        "origin",
        "destination",
        "service_type",
        "operating_carrier",
        "status",
        "observed_at",
        "note_fa",
        "metadata"
      ]
    }
  }
}
