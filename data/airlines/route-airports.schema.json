{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Airline route endpoint references (not airport guides)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "verified_at",
    "airports"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "airports": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "iata",
          "name_en",
          "country",
          "source_urls"
        ],
        "properties": {
          "iata": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "name_en": {
            "type": "string",
            "minLength": 2,
            "maxLength": 200
          },
          "country": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          },
          "source_urls": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {
              "type": "string",
              "pattern": "^https://",
              "maxLength": 2048
            }
          }
        }
      }
    }
  }
}
