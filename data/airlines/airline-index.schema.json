{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "airlines": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "airline_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,79}$"
          },
          "detail_path": {
            "type": "string",
            "pattern": "^details/[a-z][a-z0-9-]+\\.v1\\.json$"
          },
          "identity": {
            "$ref": "#/$defs/identity"
          },
          "metadata": {
            "$ref": "#/$defs/metadata"
          }
        },
        "required": [
          "airline_id",
          "detail_path",
          "identity",
          "metadata"
        ]
      },
      "maxItems": 1000
    }
  },
  "required": [
    "schema_version",
    "airlines"
  ],
  "$defs": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "draft",
            "published",
            "archived"
          ]
        },
        "source_urls": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://",
            "maxLength": 2048
          },
          "maxItems": 20
        },
        "verified_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "effective_from": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "effective_to": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "stale": {
          "type": "boolean"
        },
        "confidence": {
          "enum": [
            "official",
            "secondary",
            "unverified"
          ]
        }
      },
      "required": [
        "status",
        "source_urls",
        "verified_at",
        "effective_from",
        "effective_to",
        "stale",
        "confidence"
      ]
    },
    "code": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "system": {
          "enum": [
            "iata",
            "icao"
          ]
        },
        "value": {
          "type": "string",
          "pattern": "^[A-Z0-9]{2,3}$"
        },
        "valid_from": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "valid_to": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "shared": {
          "type": "boolean"
        }
      },
      "required": [
        "system",
        "value",
        "valid_from",
        "valid_to",
        "shared"
      ]
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name_fa": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "name_en": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "legal_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "country": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "country_fa": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "maxItems": 30
        },
        "former_names": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "maxItems": 30
        },
        "codes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/code"
          },
          "maxItems": 30
        },
        "website": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://",
          "maxLength": 2048
        }
      },
      "required": [
        "name_fa",
        "name_en",
        "legal_name",
        "country",
        "country_fa",
        "aliases",
        "former_names",
        "codes",
        "website"
      ]
    }
  }
}
