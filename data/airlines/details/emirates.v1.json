    {
      "id": "special-assistance",
      "title_fa": "خدمات ویژه و نیازهای سفر",
      "icon": "services",
      "order": 60,
      "kind": "information",
      "metadata": {
        "status": "published",
        "source_urls": [
          "https://www.emirates.com/us/english/help/accessibility-hub/",
          "https://www.emirates.com/us/english/family/planning-your-family-trip/unaccompanied-minors/",
          "https://www.emirates.com/us/english/before-you-fly/health/before-you-leave/"
