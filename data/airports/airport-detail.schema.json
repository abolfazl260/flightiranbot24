{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/abolfazl260/flightiranbot24/main/data/airports/airport-detail.schema.json",
  "title": "FlightIran Airport Per-Airport Sections v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "iata",
    "sections"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "iata": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "sections": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/section"
      }
    }
  },
  "$defs": {
    "https_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://[^\\s]+$",
      "maxLength": 2048
    },
    "text_block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "text_fa"
      ],
      "properties": {
        "type": {
          "const": "text"
        },
        "text_fa": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        }
      }
    },
    "bullets_block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "items_fa"
      ],
      "properties": {
        "type": {
          "const": "bullets"
        },
        "items_fa": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          }
        }
      }
    },
    "link_block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "title_fa",
        "url"
      ],
      "properties": {
        "type": {
          "const": "link"
        },
        "title_fa": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "url": {
          "$ref": "#/$defs/https_url"
        }
      }
    },
    "image_block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "url",
        "alt_fa"
      ],
      "properties": {
        "type": {
          "const": "image"
        },
        "url": {
          "$ref": "#/$defs/https_url"
        },
        "alt_fa": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "caption_fa": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        }
      }
    },
    "video_block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "title_fa",
        "url"
      ],
      "properties": {
        "type": {
          "const": "video"
        },
        "title_fa": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "url": {
          "$ref": "#/$defs/https_url"
        },
        "thumbnail_url": {
          "$ref": "#/$defs/https_url"
        },
        "duration_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "attribution_fa": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        }
      }
    },
    "map_block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "title_fa",
        "latitude",
        "longitude",
        "external_url"
      ],
      "properties": {
        "type": {
          "const": "map"
        },
        "title_fa": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "external_url": {
          "$ref": "#/$defs/https_url"
        },
        "image_url": {
          "$ref": "#/$defs/https_url"
        }
      }
    },
    "flight_board_block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "data_source",
        "direction"
      ],
      "properties": {
        "type": {
          "const": "flight_board"
        },
        "data_source": {
          "enum": [
            "iran_fids"
          ]
        },
        "direction": {
          "enum": [
            "arrivals",
            "departures",
            "both"
          ]
        }
      }
    },
    "experience_block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "text_fa",
        "rating",
        "visit_date",
        "approved"
      ],
      "properties": {
        "type": {
          "const": "experience"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{1,79}$"
        },
        "text_fa": {
          "type": "string",
          "minLength": 10,
          "maxLength": 2000
        },
        "rating": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "visit_date": {
          "type": "string",
          "format": "date"
        },
        "approved": {
          "type": "boolean"
        }
      }
    },
    "block": {
      "oneOf": [
        {
          "$ref": "#/$defs/text_block"
        },
        {
          "$ref": "#/$defs/bullets_block"
        },
        {
          "$ref": "#/$defs/link_block"
        },
        {
          "$ref": "#/$defs/image_block"
        },
        {
          "$ref": "#/$defs/video_block"
        },
        {
          "$ref": "#/$defs/map_block"
        },
        {
          "$ref": "#/$defs/flight_board_block"
        },
        {
          "$ref": "#/$defs/experience_block"
        }
      ]
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title_fa",
        "icon",
        "order",
        "status",
        "reviewed_at",
        "source_urls",
        "blocks"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,79}$"
        },
        "title_fa": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "subtitle_fa": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "icon": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,49}$"
        },
        "order": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "status": {
          "enum": [
            "draft",
            "published",
            "archived"
          ]
        },
        "reviewed_at": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "format": "date-time"
            }
          ]
        },
        "source_urls": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/https_url"
          }
        },
        "blocks": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "$ref": "#/$defs/block"
          }
        }
      }
    }
  }
}
